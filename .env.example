# Skopíruj tento súbor ako .env a vyplň hodnoty.

# Kde sa ukladá databáza a prílohy. MUSÍ byť mimo OneDrive!
DATA_DIR=C:\ZivnostAppData

# Port, na ktorom beží API / celá appka v produkcii
PORT=3000

# Anthropic API kľúč pre AI asistentov (moduly 5 a 6).
# Získaš na https://console.anthropic.com/ . Nikdy ho nedávaj do gitu.
ANTHROPIC_API_KEY=

# Model, ktorý AI asistenti používajú. Ak necháš prázdne, použije sa claude-opus-5.
# Lacnejšia a rýchlejšia alternatíva: claude-sonnet-5
ANTHROPIC_MODEL=

# Odosielanie faktur a upomienok mailom (volitelne).
# Priklad pre Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tvoj@gmail.com, SMTP_PASS=heslo aplikacie (nie bezne heslo!).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Písmo do PDF faktúr (voliteľné). Appka si nájde Segoe UI / Arial (Windows, Mac)
# alebo DejaVu (Linux) sama; sem daj cestu k .ttf len keď faktúra vychádza bez mäkčeňov.
PDF_FONT=
PDF_FONT_BOLD=
